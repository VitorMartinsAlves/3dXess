rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public player profiles. Authentication emails are kept in Firebase Auth, never here.
    match /users/{uid} {
      allow get, list: if true;

      // A player may create only their own initial profile with fixed starting progress.
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasAll([
          'username', 'rating', 'level', 'xp', 'rank',
          'wins', 'draws', 'losses', 'gamesPlayed', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'username', 'rating', 'level', 'xp', 'rank',
          'wins', 'draws', 'losses', 'gamesPlayed', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.username is string
        && request.resource.data.username.matches('^[A-Za-z0-9_]{3,20}$')
        && request.resource.data.rating == 1000
        && request.resource.data.level == 1
        && request.resource.data.xp == 0
        && request.resource.data.rank == 'Bronze'
        && request.resource.data.wins == 0
        && request.resource.data.draws == 0
        && request.resource.data.losses == 0
        && request.resource.data.gamesPlayed == 0
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;

      // Players cannot change rating, level, XP or match statistics from the browser.
      allow update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['avatarUrl', 'bio', 'updatedAt'])
        && request.resource.data.updatedAt is timestamp
        && (!('avatarUrl' in request.resource.data)
          || (request.resource.data.avatarUrl is string
            && request.resource.data.avatarUrl.size() <= 500))
        && (!('bio' in request.resource.data)
          || (request.resource.data.bio is string
            && request.resource.data.bio.size() <= 500));
      allow delete: if false;
    }

    match /matches/{matchId} {
      allow read: if request.auth != null
        && request.auth.uid in resource.data.playerUids;
      allow write: if false;
    }

    match /{document=**} { allow read, write: if false; }
  }
}
